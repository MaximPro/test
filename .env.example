# Environment Configuration for Local AI CRM & SuperSynergy
# Copy this file to .env and fill in your values

# ============================================================================
# COMMERCE.JS (Existing)
# ============================================================================
# Public key from Chec's demo merchant account. This client key will enable you to deploy a live preview with
# Netlify's one-click deploy. Replace this key with your own account's public key afterwards.
NEXT_PUBLIC_CHEC_PUBLIC_KEY=pk_178511bb808cdcaa54deba073eefe51688eb9cf470dfe
# Set the environment for your application, e.g. "development"
NODE_ENV=
# If you're using Stripe, add your publishable key here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key is used with chec/seeder to access your Chec account to seed it with sample data
CHEC_SECRET_KEY=
CHEC_API_URL=https://api.chec.io

# ============================================================================
# DATABASE (PostgreSQL for CRM)
# ============================================================================
DATABASE_URL=postgresql://crm_user:changeme@localhost:5432/crm
DB_PASSWORD=changeme # Change this in production!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm
DB_USER=crm_user

# ============================================================================
# REDIS (Caching & Sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD= # Leave empty for local dev

# ============================================================================
# ENCRYPTION (GDPR/DSGVO Compliance)
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# AI / OLLAMA (Local LLM)
# ============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2:13b # or llama2:70b, mistral:7b
OLLAMA_TIMEOUT=30000 # 30 seconds

# ============================================================================
# N8N (Workflow Automation)
# ============================================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=changeme # Change this!
N8N_BASIC_AUTH_ACTIVE=true

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=15m # Access token expiry
JWT_REFRESH_EXPIRY=7d # Refresh token expiry

# ============================================================================
# EMAIL (Optional, for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Your Company Name
SMTP_FROM_EMAIL=noreply@yourcompany.com

# ============================================================================
# WEBHOOKS (Commerce.js → CRM sync)
# ============================================================================
WEBHOOK_SECRET=your-webhook-secret-here

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AI_LEAD_SCORING=true
ENABLE_ABANDONED_CART=true
ENABLE_WORKFLOWS=true
ENABLE_ANALYTICS=true

# ============================================================================
# GDPR/DSGVO COMPLIANCE
# ============================================================================
DATA_RETENTION_DAYS=1095 # 3 years
CONSENT_REQUIRED=true
ENABLE_AUDIT_LOGGING=true
DPO_EMAIL=dpo@yourcompany.com # Data Protection Officer
