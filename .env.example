# ============================================
# SUPERSYNERGY ENVIRONMENT CONFIGURATION
# ============================================

# --------------------------------------------
# Application Settings
# --------------------------------------------
NODE_ENV=development
APP_NAME=SuperSynergy
APP_URL=http://localhost:3000
PORT=3000

# --------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------
DATABASE_URL="postgresql://supersynergy:your_password@localhost:5432/supersynergy?schema=public"
DIRECT_URL="postgresql://supersynergy:your_password@localhost:5432/supersynergy?schema=public"

# --------------------------------------------
# Authentication (NextAuth.js)
# --------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-minimum-32-characters-long

# --------------------------------------------
# AI Model Providers
# --------------------------------------------

# Anthropic Claude (Primary)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI GPT (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Ollama (Local LLM - Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# Default AI Provider (anthropic, openai, ollama)
DEFAULT_AI_PROVIDER=anthropic

# --------------------------------------------
# Vector Database (pgvector)
# --------------------------------------------
VECTOR_STORE_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --------------------------------------------
# Workflow Engine Configuration
# --------------------------------------------
WORKFLOW_EXECUTION_MODE=async
MAX_WORKFLOW_CONCURRENCY=10
WORKFLOW_TIMEOUT=300000
ENABLE_WORKFLOW_LOGGING=true

# --------------------------------------------
# Email Configuration
# --------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@supersynergy.ai

# SendGrid (Alternative)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# --------------------------------------------
# SMS/Communication
# --------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --------------------------------------------
# Payment Processing
# --------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --------------------------------------------
# Analytics & Monitoring
# --------------------------------------------
ENABLE_ANALYTICS=true
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# --------------------------------------------
# Redis (Caching & Queues - Optional)
# --------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --------------------------------------------
# Storage (File Uploads)
# --------------------------------------------
# Local storage path
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# S3-compatible storage (MinIO/AWS S3)
# STORAGE_TYPE=s3
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=supersynergy-uploads
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=eu-central-1

# --------------------------------------------
# External Integrations
# --------------------------------------------

# CRM Integrations
HUBSPOT_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# --------------------------------------------
# DSGVO Compliance
# --------------------------------------------
ENABLE_AUDIT_LOG=true
DATA_RETENTION_DAYS=365
ENABLE_RIGHT_TO_BE_FORGOTTEN=true
GDPR_CONTACT_EMAIL=privacy@supersynergy.ai

# --------------------------------------------
# Security
# --------------------------------------------
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
ENABLE_CSRF_PROTECTION=true
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_VOICE_AI=false
ENABLE_MULTI_LANGUAGE=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_WORKFLOW_MARKETPLACE=false

# --------------------------------------------
# Development Settings (Remove in Production)
# --------------------------------------------
DEBUG=false
ENABLE_DEV_TOOLS=true
LOG_LEVEL=info
